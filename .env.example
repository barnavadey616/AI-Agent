# TaskFlow AI Configuration

# Gemini API Key (Required for live Gemini models, leave blank to use Offline/Simulation mode)
GEMINI_API_KEY=

# Default Model: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Environment Mode: 'live' (uses Gemini API) or 'simulation' (built-in offline engine)
# If GEMINI_API_KEY is not set, it will automatically fallback to 'simulation'
TASKFLOW_MODE=auto

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Automated Watcher Directories
WATCH_DIR=demo_data/inbox
ORGANIZED_DIR=demo_data/organized
OUTPUTS_DIR=outputs
